// =====================================================================
//  Tutor-Connect Web - Prisma schema (PostgreSQL)
//  Module 1: Student Profile & Academic Info Management
//  Models: User (student | parent | admin), AcademicInfo, StudentProfile
//  Module: Tutor Profile & Schedule Management
//  Models: TutorProfile, AvailabilitySlot
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS - students, parents, and admins
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  // hashed password — null for Google-only accounts
  password      String?
  emailVerified DateTime?
  // "student" | "parent" | "admin" | "tutor"
  role          String    @default("student")
  // false until the user finishes the onboarding step (role + profile)
  onboarded     Boolean   @default(false)
  phone         String?
  location      String?
  district      String?
  isPremium        Boolean   @default(false)
  subscriptionPlan String    @default("free") // "free" | "monthly" | "yearly"
  premiumExpiresAt DateTime?
  rewardPoints     Int       @default(0)
  // AI Study Assistant daily usage tracking (free-tier limit)
  aiDailyCount     Int       @default(0)
  aiLastReset      DateTime  @default(now())
  // "active" | "suspended"  (managed by admin)
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  academicInfo    AcademicInfo[]
  studentProfiles StudentProfile[] @relation("ParentStudents")
  tutorProfile    TutorProfile?

  reviews              Review[]
  studentBookings      Booking[]             @relation("StudentBookings")
  conversations1       Conversation[]        @relation("ConvParticipant1")
  conversations2       Conversation[]        @relation("ConvParticipant2")
  sentMessages         Message[]
  notifications        Notification[]
  tutorBotMessages     TutorBotMessage[]
  subscriptionPayments SubscriptionPayment[]
  rewardLogs           RewardLog[]

  @@index([role])
}

// ACADEMIC_INFO - a student's academic details (class, institution, subjects)
// A student may have several records (e.g. one per subject group / level).
model AcademicInfo {
  id           String   @id @default(cuid())
  userId       String
  currentClass String
  institution  String
  subjects     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// STUDENT_PROFILES - multiple students managed under one parent account
model StudentProfile {
  id           String   @id @default(cuid())
  parentId     String
  studentName  String
  currentClass String
  institution  String
  subjects     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent User @relation("ParentStudents", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

// =====================================================================
//  Module: Tutor Profile & Schedule Management
//  Models: TutorProfile, AvailabilitySlot
// =====================================================================

// TUTOR_PROFILES - one row per tutor (User.role === "tutor")
model TutorProfile {
  id       String @id @default(cuid())
  userId   String @unique
  tagline  String?
  bio      String?
  // fixed lists — see SUBJECTS / CLASS_LEVELS in lib/constants.ts
  subjects     String[]
  classLevels  String[]
  // "Bangla" | "English" | "Both"
  medium    String @default("Bangla")
  hourlyFee Int
  // controls whether the tutor shows up in student search results
  isPublic  Boolean @default(true)
  // "pending" | "approved" | "rejected"  (set by admin)
  verificationStatus String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]
  reviews           Review[]
  bookings          Booking[]

  @@index([verificationStatus])
}

// AVAILABILITY_SLOTS - a tutor's weekly bookable time slots
model AvailabilitySlot {
  id        String  @id @default(cuid())
  tutorId   String
  // "Saturday".."Friday" — see DAYS_OF_WEEK in lib/constants.ts
  dayOfWeek String
  // "HH:mm", 24h (e.g. "16:00") — plain strings sort fine and need no
  // separate Time column
  startTime String
  endTime   String
  // flipped to true once the booking module claims it
  isBooked  Boolean @default(false)

  createdAt DateTime @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, dayOfWeek, startTime, endTime])
  @@index([tutorId])
}

// =====================================================================
//  Module: Tutor Search, Session Booking & Chat Room
//  Models: Review, Booking, Conversation, Message
// =====================================================================

// REVIEWS - student/parent reviews and ratings for tutors
// Tied 1:1 to the completed Booking it was left for — this is what lets us
// enforce "only after a completed session" and "one review per session".
model Review {
  id        String   @id @default(cuid())
  tutorId   String
  authorId  String
  bookingId String   @unique
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([authorId])
}

// BOOKINGS - individual tutoring session reservations
model Booking {
  id        String   @id @default(cuid())
  studentId String
  tutorId   String
  slotId    String?
  date      String   // YYYY-MM-DD
  dayOfWeek String   // Saturday..Friday
  startTime String   // HH:mm
  endTime   String   // HH:mm
  subject   String
  notes     String?
  bookingType String   @default("one_time") // "one_time" | "monthly"
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User         @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  // present once the student/parent has left feedback for this completed session
  review  Review?

  @@index([studentId])
  @@index([tutorId])
  @@index([date])
}

// CONVERSATIONS - chat threads between student/parent and tutor
model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant2Id String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participant1 User      @relation("ConvParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("ConvParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

// MESSAGES - individual chat messages
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// NOTIFICATIONS - in-app notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "parent_link_request" | "general"
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  String?  // JSON string for extra data (e.g. parentId)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

// =====================================================================
//  Module: AI Study Assistant (TutorBot)
//  Model: TutorBotMessage
// =====================================================================

// TUTORBOT_MESSAGES - persisted AI chat history per user
model TutorBotMessage {
  id           String   @id @default(cuid())
  userId       String
  // "user" | "assistant"
  role         String
  text         String
  // true when TutorBot suggests booking a live human tutor
  suggestTutor Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

// =====================================================================
//  Module: Subscription & Payment System (UddoktaPay Gateway)
//  Model: SubscriptionPayment
// =====================================================================

model SubscriptionPayment {
  id            String    @id @default(cuid())
  userId        String
  planType      String    // "monthly" | "yearly"
  amount        Int       // 150 or 1500
  referenceCode String    @unique // e.g. "UP-892140"
  invoiceId     String?   @unique // UddoktaPay invoice_id e.g. "UP170281"
  transactionId String?   @unique // bKash/Nagad TrxID
  paymentMethod String?   // "bkash" | "nagad" | "rocket" | "card"
  status        String    @default("pending") // "pending" | "verified" | "failed"
  redeemedPoints Int      @default(0)          // reward points redeemed for discount
  discountAmount Int      @default(0)          // Taka discount applied from points
  rawPayload    String?   // JSON response from UddoktaPay
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceCode])
  @@index([invoiceId])
  @@index([transactionId])
  @@index([status])
}

// =====================================================================
//  Module: Reward Points System
//  Models: SystemSetting, RewardLog
// =====================================================================

// SYSTEM_SETTINGS - admin-configurable key-value settings
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "points_per_taka", "points_booking"
  value     String   // e.g. "20"
  updatedAt DateTime @updatedAt
}

// REWARD_LOGS - tracks each point earning and redemption event
model RewardLog {
  id          String   @id @default(cuid())
  userId      String
  points      Int      // Positive = earned, Negative = redeemed
  action      String   // "booking_created" | "session_completed" | "subscription_renewed" | "review_written" | "discount_redeemed"
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
}

