DATABASE_URL="postgresql://user:password@localhost:5432/tutor_connect_web?schema=public"
AUTH_SECRET="your-auth-secret"
NEXTAUTH_SECRET="your-nextauth-secret"
AUTH_URL="http://localhost:1511"
NEXTAUTH_URL="http://localhost:1511"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
AUTH_DEMO_LOGIN="1"
ADMIN_EMAIL="admin@example.com"
GEMINI_API_KEY="your-gemini-api-key"

# Email notifications — tried in this order:
#   1. Resend (needs a verified domain — leave RESEND_API_KEY empty if you don't have one)
#   2. SMTP (e.g. a personal Gmail account + an "app password" — needs NO domain of your own)
#   3. If neither is set, emails are just logged to the console (useful for local dev)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tutor-Connect <onboarding@resend.dev>"

# --- SMTP fallback (recommended if you don't own a domain) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASS=a 16-character Gmail "App Password" (NOT your normal password —
# generate one at https://myaccount.google.com/apppasswords, requires
# 2-Step Verification to be turned on first).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Tutor-Connect\" <youraddress@gmail.com>"

# Protects the /api/cron/session-reminders endpoint. Set this to a random
# secret and configure your cron trigger (Vercel Cron, cron-job.org, etc.)
# to call the endpoint with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# All booking date/time strings are stored as local wall-clock values with
# no timezone. This is the fixed UTC offset (in minutes) used to resolve
# them to real instants for reminder scheduling. Default is Asia/Dhaka
# (UTC+6, no DST).
APP_UTC_OFFSET_MINUTES="360"
