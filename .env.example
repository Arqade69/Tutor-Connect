# =====================================================================
#  Tutor-Connect Web — environment variables
#  Copy this file to ".env" and fill in your own values.
# =====================================================================

# ---- PostgreSQL connection (REQUIRED) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# 1. Install PostgreSQL and make sure it is running on port 5432.
# 2. Create a database, e.g. in psql:  CREATE DATABASE tutor_connect_web;
# 3. Then run:  npm run db:push   &&   npm run seed
DATABASE_URL="postgresql://postgres:password@localhost:5432/tutor_connect_web?schema=public"

# ---- Auth.js secret (REQUIRED) ----
# Generate one by running:  npx auth secret
AUTH_SECRET="please-generate-with-npx-auth-secret"

# ---- Google OAuth (OPTIONAL — leave blank to use the demo login buttons) ----
# Create a Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there:
#   http://127.0.0.1:1511/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Demo login (dev convenience) ----
# When "1", the login page shows one-click "Try as Demo Student/Parent/Admin" buttons.
AUTH_DEMO_LOGIN="1"

# ---- Admin allowlist ----
# Comma-separated emails. Any Google login with one of these emails becomes an Admin.
ADMIN_EMAIL="admin@example.com"
